<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- job status -->
    <SolidColorBrush x:Key="JobStatusNew" Color="#7C8DB5" />
    <SolidColorBrush x:Key="JobStatusActive" Color="#60A5FA" />
    <SolidColorBrush x:Key="JobStatusDone" Color="#16A34A" />
    <SolidColorBrush x:Key="JobStatusInvoiced" Color="#C89455" />
    <SolidColorBrush x:Key="JobStatusOverdue" Color="#B94A48" />
    <SolidColorBrush x:Key="JobStatusPaid" Color="lime" />
    
    <!-- message box icon colours -->
    <SolidColorBrush x:Key="MessageBoxInfo" Color="#88B0D0" />
    <SolidColorBrush x:Key="MessageBoxInfoText" Color="#F8FBFD" />
    <SolidColorBrush x:Key="MessageBoxWarning" Color="#E8C08D" />
    <SolidColorBrush x:Key="MessageBoxWarningText" Color="#FDFBF8" />
    <SolidColorBrush x:Key="MessageBoxError" Color="#D68A8A" />
    <SolidColorBrush x:Key="MessageBoxErrorText" Color="#FCF8F8" />
    <SolidColorBrush x:Key="MessageBoxText" Color="#A0A0A0" />
    
    <!-- buttons -->
    <SolidColorBrush x:Key="AccentColour" Color="#8FA3C7" /> <!-- signature accent colour for borders -->
    <SolidColorBrush x:Key="NormalButton" Color="#151518" />
    <SolidColorBrush x:Key="HoverButton" Color="#1D1D22" />
    <SolidColorBrush x:Key="ClickedButton" Color="#202027" />

    <!-- dashboard -->
    <SolidColorBrush x:Key="JobsCardsBackground" Color="#0C0C0E" />
    <SolidColorBrush x:Key="JobsCardsBorder" Color="#24242A" />
    
    <!-- window forms -->
    <SolidColorBrush x:Key="FormCloseBackground" Color="#25252B" />
    <SolidColorBrush x:Key="FormCloseHoverBackground" Color="#B94A48" />
    
    <SolidColorBrush x:Key="FormMainBackground" Color="#151518" />
    <SolidColorBrush x:Key="FormFontColour" Color="#8E8E96" />
    <SolidColorBrush x:Key="FormInnerBackground" Color="#1D1D22" />
    <SolidColorBrush x:Key="FormInnerInnerBackground" Color="#1A1A1F" />
    <SolidColorBrush x:Key="FormInnerBorder" Color="#3A3A42" /> <!-- gradient -->
    
    <SolidColorBrush x:Key="FormSubmitBackground" Color="#1A1A1F" />
    <SolidColorBrush x:Key="FormSubmitHoverBackground" Color="#25252B" />
    <SolidColorBrush x:Key="FormSubmitText" Color="#E0E0E0" />

    <SolidColorBrush x:Key="DeleteText" Color="#B04141" />
    <SolidColorBrush x:Key="PlaceHolder" Color="#888888" />
    <!-- window forms -->
    
    
    
    
    <!-- sort/filter -->
    <SolidColorBrush x:Key="SortFilterMainBackground" Color="#101012" /> <!-- gradient -->
    <SolidColorBrush x:Key="SortFilterMainInnerBackground" Color="#1E1E1E" /> <!-- gradient -->

    <!-- context menu -->
    <SolidColorBrush x:Key="ContextMneuMainBackground" Color="#101012" />
    <SolidColorBrush x:Key="ContextMneuMainBorder" Color="#34343A" />

    <!-- icon -->
    <SolidColorBrush x:Key="IconBackground" Color="#18181C" />
    <SolidColorBrush x:Key="IconBorder" Color="#2A2A2F" />
    <SolidColorBrush x:Key="IconHoverBackground" Color="#25252B" />

    <!-- click animations -->
    <sys:Double x:Key="ClickOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#252525" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#333333" />
    
    
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#1E1E1E" />

    <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="LightBorderBrush" Color="#444444" />

    <!--<SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />-->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#666666" />

    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#2D4D3A" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#81C784" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#E57373" />
    <SolidColorBrush x:Key="OverdueTextBrush" Color="#FFB74D" />
    <SolidColorBrush x:Key="AccentColorBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="TableHeader" Color="#1A1A1A" />

    <SolidColorBrush x:Key="Paid" Color="#22C55E" />
    <SolidColorBrush x:Key="Unpaid" Color="#EF4444" />
    
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#1a1a1a" />

    <SolidColorBrush x:Key="SidePanelBackgroundBrush" Color="#2E2E2E" />

    <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="#252525" />

    <SolidColorBrush x:Key="BottomInfoBackgroundBrush" Color="#1F1F1F" />

    <SolidColorBrush x:Key="ListAccentBrush" Color="#2A2D2E" />

    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#0A0A0A" />



    <SolidColorBrush x:Key="FontPrimaryBrush" Color="#E0E0E0" />

    <SolidColorBrush x:Key="FontSecondaryBrush" Color="#9A9A9A" />

    <SolidColorBrush x:Key="FontMutedBrush" Color="#555555" />

    <SolidColorBrush x:Key="FontSuccessBrush" Color="#A5D6A7" />
    <SolidColorBrush x:Key="FontOverdueBrush" Color="#EF9A9A" />
    <SolidColorBrush x:Key="FontWarningBrush" Color="#FFE082" />


    <SolidColorBrush x:Key="SurfaceBrushHeader" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#2F3542"/>
    <SolidColorBrush x:Key="Grey200Brush" Color="#ECECEC"/>



    <!-- border -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#121212" />

    <SolidColorBrush x:Key="ButtonDefaultBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="DoneButtonBorderBrush" Color="#2D4D3A" />
    <SolidColorBrush x:Key="ActiveButtonBorderBrush" Color="#007ACC" />

    <!-- Datagrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource TableHeaderBackgroundBrush}"/>
        <Setter Property="Foreground" Value="#E6E6E6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="#1E1E1E"/>
        <Setter Property="AlternatingRowBackground" Value="#252525"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- DatagridRow -->
    <Style TargetType="DataGridRow">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="RowBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="2">
                        <DataGridCellsPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="#2A2A2A"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="#2E8B57"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGridColumnHeader -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource TableHeader}" />
        <Setter Property="Foreground" Value="{StaticResource FontPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="pack://Traker:,,,/Resources/Fonts/#Montserrat"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="4,4,4,6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Grey200Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">

                        <Track x:Name="PART_Track"
                           IsDirectionReversed="True">

                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                Background="#2A2A2F"
                                                CornerRadius="8"
                                                Margin="2"/>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder"
                                                        Property="Background"
                                                        Value="#4A4A55"/>
                                                </Trigger>

                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder"
                                                        Property="Background"
                                                        Value="#8FA3C7"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>

                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RepeatButton -->
    <Style TargetType="RepeatButton">
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- box -->
                        <Border x:Name="Box"
                            Width="18"
                            Height="18"
                            Background="#2A2A2A"
                            BorderBrush="#3A3F4B"
                            BorderThickness="1"
                            CornerRadius="4"
                            VerticalAlignment="Center">

                            <!-- check mark -->
                            <Path x:Name="Check"
                              Data="M2,9 L7,14 L16,3"
                              Stroke="White"
                              StrokeThickness="2"
                              Visibility="Collapsed"/>
                        </Border>

                        <!-- text -->
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>

                        <!-- checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#2E8B57"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#2E8B57"/>
                        </Trigger>

                        <!-- hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#6A707F"/>
                        </Trigger>

                        <!-- disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox readonly -->
    <Style TargetType="TextBox" x:Key="TextBoxReadOnly">
        <Setter Property="Foreground" Value="#E6E6E6"/>
        <Setter Property="Background" Value="#2A2A2A"/>
        <Setter Property="BorderBrush" Value="#3A3F4B"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                        Background="#121214"
                        BorderBrush="{StaticResource LightBorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>

                        <!-- focus glow -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#2E8B57"/>
                        </Trigger>

                        <!-- disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- TextBox -->
    <Style TargetType="TextBox" x:Key="TextBoxNormal">
        <Setter Property="Foreground" Value="#E6E6E6"/>
        <Setter Property="Background" Value="#121214"/>
        <Setter Property="BorderBrush" Value="#2A2A2F"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                        Background="#080809"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7.5"
                        SnapsToDevicePixels="True">
                        <Border.BorderBrush>
                            <!-- Top is darker, Bottom is light grey -->
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#1A1A1A" Offset="0" />
                                <GradientStop Color="#2A2A2F" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>

                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- focus glow -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                        </Trigger>

                        <!-- disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePickerTextBox -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <TextBox x:Name="PART_TextBox"
                             Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                             Background="#252525"
                             Foreground="White"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="5,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Combobox -->
    <Style TargetType="ComboBox" x:Key="ComboBoxNormal">

        <!-- NORMAL COMBOBOX TEXT COLOUR -->
        <Setter Property="Foreground" Value="#F2EAEA"/>

        <!-- NORMAL COMBOBOX BACKGROUND COLOUR -->
        <Setter Property="Background" Value="#080809"/>

        <!-- NORMAL COMBOBOX BORDER COLOUR -->
        <Setter Property="BorderBrush" Value="#2A2A2F"/>

        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>

                        <ToggleButton x:Name="ToggleButton"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}">

                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">

                                    <Border x:Name="ComboBoxBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">

                                        <Grid>
                                            <ContentPresenter Margin="12,0,35,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          RecognizesAccessKey="True"/>

                                            <!-- ARROW COLOUR / CLOSED ARROW DOWN -->
                                            <Path x:Name="Arrow"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="#F2EAEA"
                                              Width="8"
                                              Height="4"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0"/>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <!-- COMBOBOX HOVER COLOURS -->
                                        <Trigger Property="IsMouseOver" Value="True">

                                            <!-- HOVER BACKGROUND COLOUR -->
                                            <Setter TargetName="ComboBoxBorder"
                                                Property="Background"
                                                Value="#080809"/>

                                            <!-- HOVER BORDER COLOUR -->
                                            <Setter TargetName="ComboBoxBorder"
                                                Property="BorderBrush"
                                                Value="{StaticResource AccentColour}"/>
                                        </Trigger>

                                        <!-- DROPDOWN OPEN: ARROW UP -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow"
                                                Property="Data"
                                                Value="M 0 4 L 4 0 L 8 4 Z"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      Margin="12,0,35,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>

                        <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">

                            <!-- DROPDOWN BACKGROUND / BORDER -->
                            <Border Background="#101012"
                                BorderBrush="#34343A"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="4"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="250">

                                <ScrollViewer MaxHeight="250"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly">
                                    <ItemsPresenter/>
                                </ScrollViewer>

                            </Border>
                        </Popup>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">

                    <!-- DROPDOWN ITEM TEXT COLOUR -->
                    <Setter Property="Foreground" Value="#F2EAEA"/>

                    <!-- NORMAL DROPDOWN ITEM BACKGROUND -->
                    <Setter Property="Background" Value="Transparent"/>

                    <Setter Property="Padding" Value="10,6"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">

                                <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="12,10">

                                    <ContentPresenter VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <!-- DROPDOWN ITEM HOVER BACKGROUND -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="#1D1D22"/>
                                    </Trigger>

                                    <!-- DROPDOWN ITEM SELECTED BACKGROUND -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="#25252B"/>
                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground"
                                            Value="#777777"/>
                                    </Trigger>

                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltip -->
    <Style x:Key="DarkToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="#1E1E1E"/>
        <Setter Property="Foreground" Value="#EAEAEA"/>
        <Setter Property="BorderBrush" Value="#3A3F4B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HasDropShadow" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>