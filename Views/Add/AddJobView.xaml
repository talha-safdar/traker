<UserControl x:Class="Traker.Views.Add.AddJobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:local="clr-namespace:Traker.Views" 
             xmlns:viewmodels="clr-namespace:Traker.ViewModels" 
             mc:Ignorable="d" 
             xmlns:behaviours="clr-namespace:Traker.Behaviours"
             xmlns:conv="clr-namespace:Traker.Converters"
             d:DesignHeight="600" 
             d:DesignWidth="500"
             MaxHeight="700"
             MaxWidth="550"
             Focusable="True"
             cal:Message.Attach="[Event PreviewKeyDown] = [Action HandleKeyPress($eventArgs)]">

    <Border Margin="5" Background="{StaticResource FormMainBackground}" CornerRadius="20" BorderThickness="1.5" SnapsToDevicePixels="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                <GradientStop Color="LightGray" Offset="0" />
                <GradientStop Color="Transparent" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="30,20,30,20">
            <Grid.RowDefinitions>
                <!-- top bar -->
                <RowDefinition Height="0.1*" />
                
                <!-- main contents -->
                <RowDefinition Height="*" />
                
                <!-- buttons -->
                <RowDefinition Height="0.15*" />
            </Grid.RowDefinitions>

            <!-- top bar -->
            <Grid Grid.Row="0">
                <Border Cursor="Hand" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action Exit()]" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="20" Height="35" Width="35">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource FormCloseBackground}"/>
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource FormCloseHoverBackground}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Border.Triggers>
                        <!-- click animation -->
                        <EventTrigger RoutedEvent="MouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <svg:SvgViewbox                       
                        Margin="0,1,0,0"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        Source="/Resources/Media/Images/Icons/Lucide/x.svg" Width="15" Height="15"/>
                </Border>
            </Grid>

            <!-- main contents -->
            <Grid Grid.Row="1">
                <Border Background="{StaticResource FormInnerBackground}" CornerRadius="15" BorderThickness="1.5" Margin="50,20" SnapsToDevicePixels="True">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                            <GradientStop Color="#3A3A42" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid Margin="20,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <!-- client selection -->
                            <RowDefinition Height="*" />
                            
                            <!-- job title -->
                            <RowDefinition Height="*" />
                            
                            <!-- price -->
                            <RowDefinition Height="*" />
                            
                            <!-- due date -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- client selection -->
                        <Grid Grid.Row="0" Margin="0,0,0,25">
                            <StackPanel Orientation="Vertical">
                                <TextBlock VerticalAlignment="Center" Margin="5,0,0,5" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22">
                                <Run Text="Number of Clients: " />
                                    <Run Text="{Binding AddJob.Count, Mode=OneWay}" />
                                </TextBlock>
                                <ComboBox Style="{DynamicResource ComboBoxNormal}"
                                        MaxDropDownHeight="300"
                                        IsEditable="False"
                                        FontWeight="Regular"
                                        HorizontalAlignment="Stretch" 
                                        FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                        ItemsSource="{Binding AddJob}"
                                        SelectedItem="{Binding SelectedClient, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding BusinessName}"
                                                    FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" FontWeight="Regular" FontSize="22" Margin="0,1,0,0"/>
                                                <TextBlock FontSize="12" FontFamily="pack://Traker:,,,/Resources/Fonts/#Inter" FontWeight="Medium" Opacity="0.5">
                                                    <Run Text="Created Date: " />
                                                    <Run Text="{Binding CreatedDate}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- job title -->
                        <Grid Grid.Row="1" Margin="0,0,0,25">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Margin="5,0,0,5" Text="Job Title" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding JobTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                    behaviours:TextboxFilter.EnableFilter="True"
                                    behaviours:TextboxFilter.FilterMode="AlphaNumericWithSpaces" />
                            </StackPanel>
                        </Grid>

                        <!-- price -->
                        <Grid Grid.Row="2" Margin="0,0,0,25">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Margin="5,0,0,5" Text="Price" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                    behaviours:TextboxFilter.EnableFilter="True"
                                    behaviours:TextboxFilter.FilterMode="Currency" />
                            </StackPanel>
                        </Grid>

                        <!-- due date -->
                        <Grid Grid.Row="3" Margin="0,0,0,0">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Margin="5,0,0,5" Text="Due Date" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding DueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                    behaviours:TextboxFilter.EnableFilter="True"
                                    behaviours:TextboxFilter.FilterMode="DateDDMMYYYY" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- butons -->
            <Grid Grid.Row="2" Opacity="{Binding OpacitySubmitBtn}">
                <Border Cursor="Hand" x:Name="SubmitBorder" IsEnabled="{Binding EnableSubmitBtn}" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action AddJobToClient()]" CornerRadius="25" Height="45" Margin="150,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="1.5" />
                            <Setter Property="Background" Value="{StaticResource FormSubmitBackground}" />

                            <!-- DEFAULT STATE -->
                            <Setter Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                        <GradientStop Color="LightGray" Offset="0" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>

                            <!-- HOVER STATE -->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource FormSubmitHoverBackground}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Border.Triggers>
                        <!-- click animation -->
                        <EventTrigger RoutedEvent="MouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <TextBlock conv:TextBlockSpacer.LetterSpacing="2.01" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Add Job" FontFamily="pack://Traker:,,,/Resources/Fonts/#Inter" FontWeight="SemiBold" Foreground="{StaticResource FormSubmitText}" FontSize="16" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
