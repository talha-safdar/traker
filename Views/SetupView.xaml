<UserControl x:Class="Traker.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Traker.Converters"
             xmlns:local="clr-namespace:Traker.Views"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:behaviours="clr-namespace:Traker.Behaviours"
             xmlns:cal="http://caliburnmicro.com"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="800">

    <UserControl.Resources>
        <conv:BoolToVisibilityCollapsed x:Key="BoolToVisCollapsed"/>
    </UserControl.Resources>

    <Grid>
        <!--#region user setup-->
        <Border Height="800" Width="1000" Visibility="{Binding SetupWindows[0], Converter={StaticResource BoolToVisCollapsed}}" Background="{StaticResource FormMainBackground}" CornerRadius="20" BorderThickness="1.5" SnapsToDevicePixels="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                    <GradientStop Color="LightGray" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid Margin="30,20,30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*" />                    <!-- top bar        -->
                    <RowDefinition Height="auto" />                    <!-- main contents       -->
                    <RowDefinition Height="0.15*" />                    <!-- buttons        -->
                </Grid.RowDefinitions>

                <!-- top bar -->
                <Grid Grid.Row="0">
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Welcome to TRAKER" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Bold" FontSize="58">

                        <TextBlock.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop x:Name="RevealStop" Color="White" Offset="0"/>
                                <GradientStop x:Name="FadeStop" Color="Transparent" Offset="0.18"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.OpacityMask>

                        <TextBlock.Foreground>
                            <LinearGradientBrush x:Name="TextBrush" StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#666666" Offset="0"/>
                                <GradientStop Color="#FFFFFF" Offset="0.6"/>
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform x:Name="GradientTransform"/>
                                </LinearGradientBrush.RelativeTransform>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Triggers>



                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation
                        Storyboard.TargetName="RevealStop"
                        Storyboard.TargetProperty="Offset"
                        From="0"
                        To="1"
                        Duration="0:0:3"/>

                                        <DoubleAnimation
                        Storyboard.TargetName="FadeStop"
                        Storyboard.TargetProperty="Offset"
                        From="0.18"
                        To="1.18"
                        Duration="0:0:3"/>

                                        <ObjectAnimationUsingKeyFrames
    Storyboard.TargetProperty="OpacityMask"
    BeginTime="0:0:3">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Null}"/>
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>


                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="GradientTransform" Storyboard.TargetProperty="Y" From="-0.2" To="0.2" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>

                <!-- main contents -->
                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="80,0,80,0">
                    <Grid Margin="30,0,30,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />                            <!-- instructions -->
                            <RowDefinition Height="auto" />                            <!-- details -->
                        </Grid.RowDefinitions>

                        <!-- instructions -->
                        <Grid Grid.Row="0">

                        </Grid>

                        <!-- details -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />                                <!-- user info -->
                                <RowDefinition Height="auto" />                                <!-- type -->
                            </Grid.RowDefinitions>

                            <!-- user info -->
                            <Grid Grid.Row="0">
                                <Border Background="{StaticResource FormInnerBackground}" CornerRadius="15" BorderThickness="1.5" Margin="40,20" SnapsToDevicePixels="True">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                            <GradientStop Color="#3A3A42" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    
                                    <Grid Margin="30">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />                                            <!-- name -->
                                            <RowDefinition Height="auto" />                                            <!-- email -->
                                            <RowDefinition Height="auto" />                                            <!-- phone -->
                                            <RowDefinition Height="auto" />                                            <!-- type -->
                                        </Grid.RowDefinitions>

                                        <!-- name -->
                                        <Grid Grid.Row="1" Margin="0,0,0,25">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Margin="5,0,0,5" Text="Full Name" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                                <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                                behaviours:TextboxFilter.EnableFilter="True"
                                                behaviours:TextboxFilter.FilterMode="LettersAndSpacesOnly" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- email -->
                                        <Grid Grid.Row="2" Margin="0,0,0,25">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Margin="5,0,0,5" Text="Email" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                                <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                                behaviours:TextboxFilter.EnableFilter="True"
                                                behaviours:TextboxFilter.FilterMode="Email" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- phone -->
                                        <Grid Grid.Row="3">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Margin="5,0,0,5" Text="Phone" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                                <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                                behaviours:TextboxFilter.EnableFilter="True"
                                                behaviours:TextboxFilter.FilterMode="DigitsOnly" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- type -->
                            <Grid Grid.Row="1">
                                <Border Background="{StaticResource FormInnerBackground}" CornerRadius="15" BorderThickness="1.5" Margin="40,20" SnapsToDevicePixels="True">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                            <GradientStop Color="#3A3A42" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    
                                    <Grid Margin="30">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>

                                        <!-- title -->
                                        <Grid Grid.Row="0" Margin="0,0,0,25">
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Busienss Type" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Bold" Foreground="{StaticResource FontPrimaryBrush}" FontSize="28" />
                                        </Grid>

                                        <!-- spacer -->
                                        <Grid Grid.Row="1" />

                                        <Grid Grid.Row="2" HorizontalAlignment="Center">
                                            <Border Background="{StaticResource FormInnerInnerBackground}" CornerRadius="25" BorderThickness="1.5" VerticalAlignment="Center" SnapsToDevicePixels="True">

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <!-- indiviudal -->
                                                    <Border IsEnabled="{Binding ToggleButtons[0]}" x:Name="Indvidualbtn" Cursor="Hand" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action SetBusinessType('Individual')]" CornerRadius="25" Height="45" Width="200" Margin="0,0,100,0">

                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                
                                                                <Setter Property="Background" Value="{Binding BackgroundButtons[0]}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />

                                                                <!-- Default BorderBrush -->
                                                                <Setter Property="BorderBrush">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                                                            <GradientStop Color="#FFFFFF" Offset="0" />
                                                                            <GradientStop Color="Transparent" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ToggleButtons[0]}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>

                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <!-- Increase opacity to rgba 255,255,255, 0.1 -->
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentColour}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0" Text="Individual" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" FontWeight="Medium" FontSize="16">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <!-- Default State -->
                                                                    <Setter Property="Foreground" Value="{Binding ForegroundText[0]}" />

                                                                    <Style.Triggers>
                                                                        <!-- Watch the 'IsMouseOver' property of the element named 'MyBorder' -->
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Indvidualbtn}" Value="True">
                                                                            <Setter Property="Foreground" Value="#CCCCCC" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- company -->
                                                    <Border IsEnabled="{Binding ToggleButtons[1]}" x:Name="Companybtn" Cursor="Hand" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action SetBusinessType('Company')]" CornerRadius="25" Height="45" Width="200" Margin="0,0,0,0">

                                                        <Border.Style>
                                                            <Style TargetType="Border">

                                                                <Setter Property="Background" Value="{Binding BackgroundButtons[1]}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />

                                                                <!-- Default BorderBrush -->
                                                                <Setter Property="BorderBrush">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                                                            <GradientStop Color="#FFFFFF" Offset="0" />
                                                                            <GradientStop Color="Transparent" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ToggleButtons[1]}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>

                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <!-- Increase opacity to rgba 255,255,255, 0.1 -->
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentColour}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0" Text="Company" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" FontWeight="Medium" FontSize="16">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <!-- Default State -->
                                                                    <Setter Property="Foreground" Value="{Binding ForegroundText[1]}" />

                                                                    <Style.Triggers>
                                                                        <!-- Watch the 'IsMouseOver' property of the element named 'MyBorder' -->
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Companybtn}" Value="True">
                                                                            <Setter Property="Foreground" Value="#CCCCCC" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>                    
                </Grid>

                <!-- butons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" /> <!-- empty -->
                        <ColumnDefinition Width="*" /> <!-- stage -->
                        <ColumnDefinition Width="0.5*" /> <!-- next -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- empty -->
                    <Grid Grid.Column="0">
                        
                    </Grid>
                    
                    <!-- stage -->
                    <Grid Grid.Column="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <svg:SvgViewbox Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="/Resources/Media/Images/Icons/Lucide/user-round.svg" Width="20" Height="20"/>
                            <svg:SvgViewbox Margin="0,0,20,0" Opacity="0.5" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="/Resources/Media/Images/Icons/Lucide/briefcase-business.svg" Width="15" Height="15"/>
                            <svg:SvgViewbox Margin="0,0,0,0" Opacity="0.5" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="/Resources/Media/Images/Icons/Lucide/landmark.svg" Width="15" Height="15"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- next -->
                    <Grid Grid.Column="2" Opacity="{Binding OpacityBtn}">
                        <!-- next -->
                        <Border x:Name="SubmitBorder1" MouseLeave="SubmitBorder1_MouseLeave" IsEnabled="{Binding EnableNextBtn}" HorizontalAlignment="Right" Cursor="Hand" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action ConfirmUserSetup()]" CornerRadius="25" Height="50" Width="50" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Background" Value="#1D1D22" />

                                    <!-- DEFAULT STATE -->
                                    <Setter Property="BorderBrush">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                                <GradientStop Color="LightGray" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>

                                    <!-- HOVER STATE -->
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#25252B"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Triggers>
                                <!-- click animation -->
                                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <svg:SvgViewbox Margin="2,2,0,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="/Resources/Media/Images/Icons/Lucide/chevron-right.svg" Width="20" Height="20"/>
                        </Border>
                    </Grid>    
                </Grid>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region business setup -->
        <!--#region individual-->
        <Border Height="800" Width="1000" Visibility="{Binding SetupWindows[1], Converter={StaticResource BoolToVisCollapsed}}" Background="{StaticResource FormMainBackground}" CornerRadius="20" BorderThickness="1.5" SnapsToDevicePixels="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                    <GradientStop Color="LightGray" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid Margin="30,20,30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*" />                    <!-- top bar        -->
                    <RowDefinition Height="auto" />                    <!-- main contents       -->
                    <RowDefinition Height="0.15*" />                    <!-- buttons        -->
                </Grid.RowDefinitions>

                <!-- top bar -->
                <Grid Grid.Row="0">
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Welcome to TRAKER" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Bold" FontSize="58">
                        <TextBlock.Foreground>
                            <LinearGradientBrush x:Name="TextBrush1" StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#666666" Offset="0"/>
                                <GradientStop Color="#FFFFFF" Offset="0.6"/>
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform x:Name="GradientTransform1"/>
                                </LinearGradientBrush.RelativeTransform>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="GradientTransform1" Storyboard.TargetProperty="Y" From="-0.2" To="0.2" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>

                <!-- main contents -->
                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="80,30,80,30">
                    <Border Background="{StaticResource FormInnerBackground}" CornerRadius="15" BorderThickness="1.5"  Margin="70,0" SnapsToDevicePixels="True">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                <GradientStop Color="#3A3A42" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>

                        <Grid Margin="30,20,30,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />                                <!-- name -->
                                <RowDefinition Height="auto" />                                <!-- country -->
                                <RowDefinition Height="auto" />                                <!-- city -->
                                <RowDefinition Height="auto" />                                <!-- address -->
                                <RowDefinition Height="auto" />                                <!-- postcode -->
                            </Grid.RowDefinitions>

                            <!-- name -->
                            <Grid Grid.Row="0" Margin="0,0,0,25">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Margin="5,0,0,5" Text="Business Name" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                    <TextBox Opacity="0.6" IsHitTestVisible="False" Focusable="False" Style="{DynamicResource TextBoxNormal}" Text="{Binding BusinessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                    behaviours:TextboxFilter.EnableFilter="True"
                                    behaviours:TextboxFilter.FilterMode="LettersAndSpacesOnly" />
                                </StackPanel>
                            </Grid>

                            <!-- country -->
                            <Grid Grid.Row="1" Margin="0,0,0,25">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Margin="5,0,0,5" Text="Country" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                    <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                    behaviours:TextboxFilter.EnableFilter="True"
                                    behaviours:TextboxFilter.FilterMode="LettersAndSpacesOnly" />
                                </StackPanel>
                            </Grid>

                            <!-- city -->
                            <Grid Grid.Row="2" Margin="0,0,0,25">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Margin="5,0,0,5" Text="City" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                    <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                    behaviours:TextboxFilter.EnableFilter="True"
                                    behaviours:TextboxFilter.FilterMode="LettersAndSpacesOnly" />
                                </StackPanel>
                            </Grid>

                            <!-- address -->
                            <Grid Grid.Row="3" Margin="0,0,0,25">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Margin="5,0,0,5" Text="Address" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                    <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                    behaviours:TextboxFilter.EnableFilter="True"
                                    behaviours:TextboxFilter.FilterMode="AlphaNumericWithSpaces" />
                                </StackPanel>
                            </Grid>

                            <!-- postcode -->
                            <Grid Grid.Row="4" Margin="0,0,0,25">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Margin="5,0,0,5" Text="Postcode" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                    <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding Postcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                    behaviours:TextboxFilter.EnableFilter="True"
                                    behaviours:TextboxFilter.FilterMode="AlphaNumericWithSpaces" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- butons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" />
                        <!-- empty -->
                        <ColumnDefinition Width="*" />
                        <!-- stage -->
                        <ColumnDefinition Width="0.5*" />
                        <!-- next -->
                    </Grid.ColumnDefinitions>

                    <!-- empty -->
                    <Grid Grid.Column="0">

                    </Grid>

                    <!-- stage -->
                    <Grid Grid.Column="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <svg:SvgViewbox Margin="0,0,20,0" Opacity="0.5" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="/Resources/Media/Images/Icons/Lucide/user-round.svg" Width="15" Height="15"/>
                            <svg:SvgViewbox Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="/Resources/Media/Images/Icons/Lucide/briefcase-business.svg" Width="20" Height="20"/>
                            <svg:SvgViewbox Margin="0,0,0,0" Opacity="0.5" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="/Resources/Media/Images/Icons/Lucide/landmark.svg" Width="15" Height="15"/>
                        </StackPanel>
                    </Grid>

                    <!-- next -->
                    <Grid Grid.Column="2" Opacity="{Binding OpacityBtn}">
