<UserControl x:Class="Traker.Views.JobsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Traker.Views"
             xmlns:cal="http://caliburnmicro.com" 
             xmlns:conv="clr-namespace:Traker.Converters"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             Height="800" Width="1000">

    <Border Margin="5" Background="{StaticResource FormMainBackground}" CornerRadius="20" BorderThickness="1.5" SnapsToDevicePixels="True" cal:Message.Attach="[Event PreviewMouseDown] = [Action OnMouseDownEvent($source)]">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                <GradientStop Color="LightGray" Offset="0" />
                <GradientStop Color="Transparent" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="30,20,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.05*" />                <!-- top bar        -->
                <RowDefinition Height="*" />                <!-- main contents       -->
            </Grid.RowDefinitions>

            <!-- top bar -->
            <Grid Grid.Row="0">
                <Border Cursor="Hand" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action Exit()]" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="20" Height="35" Width="35">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#25252B"/>
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#B94A48"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Border.Triggers>
                        <!-- click animation -->
                        <EventTrigger RoutedEvent="MouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <svg:SvgViewbox                       
                        Margin="0,1,0,0"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        Source="/Resources/Media/Images/Icons/Lucide/x.svg" Width="15" Height="15"/>
                </Border>
            </Grid>

            <!-- main contents -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="30,0,30,0" Height="600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" /> <!-- client name -->
                    <RowDefinition Height="0.03*" /> <!-- spacer -->
                    <RowDefinition Height="*" /> <!-- list-->
                </Grid.RowDefinitions>

                <!-- client name -->
                <Grid Grid.Row="0">
                    <Border Background="{StaticResource FormInnerBackground}" CornerRadius="15" SnapsToDevicePixels="True" HorizontalAlignment="Center" BorderThickness="1.5">            
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                <!-- This whole gradient is now at 50% of its original opacity -->
                                <GradientStop Color="LightGray" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <svg:SvgViewbox   
                                    Opacity="0.7"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="{Binding ClientType}" Width="25" Height="25"/>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding BusinessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FontPrimaryBrush}" FontSize="34" />
                        </StackPanel>                        
                    </Border>
                </Grid>

                <Grid Grid.Row="1" />

                <!-- list-->
                <Border Grid.Row="2" Background="{StaticResource FormInnerBackground}" CornerRadius="15" SnapsToDevicePixels="True" BorderThickness="1.5" >
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                            <GradientStop Color="#3A3A42" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    
                    <ListBox ItemsSource="{Binding JobsList}"
                             Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"

                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.CacheLength="2"
                            VirtualizingPanel.CacheLengthUnit="Page">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,20,0,10"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border 
                                        SnapsToDevicePixels="True"
                                        BorderThickness="1.5"
                                        ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="2000" 
                                        Height="135"
                                        CornerRadius="20" 
                                        Margin="20,0,20,0" 
                                        Padding="10"
                                        cal:Message.Attach="[Event MouseLeftButtonUp] = [Action SelectJob($dataContext)];
                                                            [Event MouseEnter] = [Action SelectJob($dataContext)];
                                                            [Event MouseRightButtonUp] = [Action OpenContextMenu($dataContext)];"
                                            Cursor="Hand"
                                        MouseLeftButtonDown="EditJob">
                                        
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <!-- The "Rim Light" on the top edge -->
                                                <GradientStop Color="#40FFFFFF" Offset="0" />
                                                <!-- Fades to transparent so the bottom/sides stay dark -->
                                                <GradientStop Color="Transparent" Offset="0.2" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.ToolTip>
                                            <ToolTip Style="{StaticResource DarkToolTip}"
                                                Content="Double-click to edit job | right click for more"/>
                                        </Border.ToolTip>


                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- 1. Default BorderBrush -->
                                            <Setter Property="Background" Value="#151518"/>
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#4A4A55" Offset="0"/>
                                                        <GradientStop Color="#2D2D34" Offset="0.45"/>
                                                        <GradientStop Color="#1F1F25" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <!-- 2. Default Shadow (Moved from local to Style) -->
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="Black" 
                  BlurRadius="15" 
                 Direction="270"
                  ShadowDepth="5" 
                  Opacity="0.4" 
                  RenderingBias="Quality"/>
                                                </Setter.Value>
                                            </Setter>

                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1D1D22"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                                                    <!-- on pressed:
                Background: #202027
                Border:     #A7B4CC-->


                                                    <!-- 3. Increased Blur Shadow on Hover -->
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="Black" 
                      BlurRadius="30" 
                      ShadowDepth="0" 
                      Opacity="0.8" 
                      RenderingBias="Quality"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>



                                    <Grid IsHitTestVisible="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />                                                <!-- job title -->
                                                <ColumnDefinition Width="0.2*" />                                                <!-- spacer -->
                                                <ColumnDefinition Width="*" />                                                <!-- job status / due date -->
                                                <ColumnDefinition Width="0.2*" />                                                <!-- spacer -->
                                                <ColumnDefinition Width="*" />                                                <!-- job price -->
                                            </Grid.ColumnDefinitions>

                                            <!-- full name / job title -->
                                            <Grid Margin="30,0,0,0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <!-- job title -->
                                                <Grid Grid.Row="2">
                                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding JobTitle}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="SemiBold" Foreground="{StaticResource FontPrimaryBrush}" FontSize="24" />                                                    
                                                </Grid>
                                            </Grid>

                                            <!-- spacer-->
                                            <Grid Grid.Column="1">
                                            </Grid>

                                            <!-- job status / due date -->
                                            <Grid Grid.Column="2" HorizontalAlignment="Center">
                                                <Grid Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />                                                        <!-- job status -->
                                                        <RowDefinition Height="0.5*" />                                                        <!-- spacer -->
                                                        <RowDefinition Height="*" />                                                        <!-- due date -->
                                                    </Grid.RowDefinitions>

                                                    <!-- job status -->
                                                    <Grid Grid.Row="0">
                                                    <TextBlock Margin="0" Text="{Binding JobStatus}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Black" FontSize="24" Foreground="{StaticResource FontPrimaryBrush}" />
                                                </Grid>

                                                    <!-- spacer -->
                                                    <Grid Grid.Row="1" Margin="0,10" />

                                                    <!-- due date -->
                                                    <Grid Grid.Row="2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock HorizontalAlignment="Left" Margin="0" Text="Due" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Bold" Foreground="{StaticResource FontSecondaryBrush}" FontSize="24" />
                                                            <TextBlock Margin="10,0,0,0" Text="{Binding DueDate}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FontPrimaryBrush}" FontSize="24" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Grid>

                                            <!-- spacer -->
                                            <Grid Grid.Column="3">
                                            </Grid>

                                            <!-- job price -->
                                            <Grid Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Margin="0" Text="{Binding Price, StringFormat={}{0:C}}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" FontWeight="SemiBold" Foreground="{StaticResource FontPrimaryBrush}" FontSize="32" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>