<UserControl x:Class="Traker.Views.Edit.EditClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Traker.Views"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:conv="clr-namespace:Traker.Converters"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:behaviours="clr-namespace:Traker.Behaviours"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800" 
             Height="800" 
             Width="1000"
             Focusable="True"
             cal:Message.Attach="[Event PreviewKeyDown] = [Action HandleKeyPress($eventArgs)]">

    <Border Margin="5" Background="{StaticResource FormMainBackground}" CornerRadius="20" BorderThickness="1.5" SnapsToDevicePixels="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                <GradientStop Color="LightGray" Offset="0" />
                <GradientStop Color="Transparent" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="30,20,30,20">
            <Grid.RowDefinitions>
                <!-- top bar -->
                <RowDefinition Height="0.1*" />
                
                <!-- main contents -->
                <RowDefinition Height="auto" />
                
                <!-- buttons -->
                <RowDefinition Height="0.15*" />
            </Grid.RowDefinitions>

            <!-- top bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- button -->
                    <ColumnDefinition Width="*"/>
                    
                    <!-- close -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- button -->
                <Grid Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Cursor="Hand" x:Name="SubmitOpenJobsBorder" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="5000" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action OpenJobsList()]" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="40" Height="45" Width="45">
                            <Border.ToolTip>
                                <ToolTip Style="{StaticResource DarkToolTip}"
                                    Content="Open Client's job list"/>
                            </Border.ToolTip>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                    <Setter Property="Background" Value="{StaticResource IconBackground}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource IconBorder}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource IconHoverBackground}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Triggers>
                                <!-- click animation -->
                                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Canvas>
                                <svg:SvgViewbox Canvas.Left="10" Canvas.Top="10" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="/Resources/Media/Images/Icons/Lucide/briefcase-business.svg" Width="20" Height="20"/>
                                <Border Canvas.Left="20" Canvas.Top="18">
                                    <Grid Background="{StaticResource IconBackground}" Width="18" Height="18">
                                        <svg:SvgViewbox RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="/Resources/Media/Images/Icons/Lucide/list.svg" Width="10" Height="10"/>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Border>
                        <TextBlock VerticalAlignment="Center" Margin="10,5,5,0" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="SemiBold" Foreground="{StaticResource FontPrimaryBrush}" FontSize="34">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Default Value client name -->
                                    <Setter Property="Text" Value="{Binding ClientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Style.Triggers>
                                        <!-- if client type is company use company name -->
                                        <DataTrigger Binding="{Binding ClientType}" Value="Company">
                                            <Setter Property="Text" Value="{Binding CompanyName}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- close -->
                <Grid Grid.Column="1">
                    <Border Cursor="Hand" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action Exit()]" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="20" Height="35" Width="35">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource FormCloseBackground}"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource FormCloseHoverBackground}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Border.Triggers>
                            <!-- click animation -->
                            <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>

                        <svg:SvgViewbox                       
                            Margin="0,1,0,0"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True"
                            Source="/Resources/Media/Images/Icons/Lucide/x.svg" Width="15" Height="15"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- main contents -->
            <Grid Grid.Row="1">
                <Grid Margin="0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />

                        <!-- client -->
                        <ColumnDefinition Width="*" />

                        <!-- address -->
                    </Grid.ColumnDefinitions>

                    <!-- client -->
                    <Grid Grid.Column="0">
                        <Border Background="{StaticResource FormInnerBackground}" CornerRadius="15" BorderThickness="1.5" Margin="40,20" SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                    <GradientStop Color="#3A3A42" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid Margin="30">
                                <Grid.RowDefinitions>
                                    <!-- client type -->
                                    <RowDefinition Height="*" />
                                    
                                    <!-- business name -->
                                    <RowDefinition Height="*" />
                                    
                                    <!-- full name -->
                                    <RowDefinition Height="*" />
                                    
                                    <!-- email address -->
                                    <RowDefinition Height="*" />
                                    
                                    <!-- phone numbers -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- client type -->
                                <Grid Grid.Row="0" Margin="0,0,0,25">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock VerticalAlignment="Center" Margin="5,0,0,5" Text="Client Type" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22" />
                                        <ComboBox Style="{DynamicResource ComboBoxNormal}" SelectedValue="{Binding ClientType, Mode=TwoWay}" SelectedValuePath="Content" FontSize="22">
                                            <ComboBoxItem Content="Individual" IsSelected="True" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" />
                                            <ComboBoxItem Content="Company" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- company name -->
                                <Grid Grid.Row="1" Margin="0,0,0,25">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Margin="5,0,0,5" Text="Business Name" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                        <TextBox Text="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                            behaviours:TextboxFilter.EnableFilter="True"
                                            behaviours:TextboxFilter.FilterMode="LettersAndSpacesOnly">
                                            <TextBox.Style>
                                                <!-- Use BasedOn to keep your existing style's look -->
                                                <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxNormal}">

                                                    <Setter Property="Opacity" Value="1.0" />
                                                    <Setter Property="IsHitTestVisible" Value="True" />
                                                    <Setter Property="Focusable" Value="True" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ClientType}" Value="Individual">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                            <Setter Property="Focusable" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>

                                <!-- full name -->
                                <Grid Grid.Row="2" Margin="0,0,0,25">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Margin="5,0,0,5" Text="Client Name" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                        <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding ClientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                            behaviours:TextboxFilter.EnableFilter="True"
                                            behaviours:TextboxFilter.FilterMode="LettersAndSpacesOnly" />
                                    </StackPanel>
                                </Grid>

                                <!-- email address -->
                                <Grid Grid.Row="3" Margin="0,0,0,25">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Margin="5,0,0,5" Text="Client Email" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                        <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding ClientEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                        behaviours:TextboxFilter.EnableFilter="True"
                                        behaviours:TextboxFilter.FilterMode="Email" />
                                    </StackPanel>
                                </Grid>

                                <!-- phone number -->
                                <Grid Grid.Row="4" Margin="0,0,0,0">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Margin="5,0,0,5" Text="Phone Number" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                        <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                            behaviours:TextboxFilter.EnableFilter="True"
                                            behaviours:TextboxFilter.FilterMode="DigitsOnly" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- address -->
                    <Grid Grid.Column="1">
                        <Border Background="{StaticResource FormInnerBackground}" CornerRadius="15" BorderThickness="1.5" Margin="40,20" SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                    <GradientStop Color="#3A3A42" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid Margin="30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <!-- home address -->
                                    <RowDefinition Height="*" />
                                    <!-- home address -->
                                    <RowDefinition Height="*" />
                                    <!-- city -->
                                    <RowDefinition Height="*" />
                                    <!-- postcode -->
                                    <RowDefinition Height="*" />
                                    <!-- country -->
                                </Grid.RowDefinitions>

                                <!-- home address -->
                                <Grid Grid.RowSpan="2" Margin="0,0,0,25">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Margin="5,0,0,5" Text="Home Address" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                        <TextBox Width="320" Height="149" Style="{DynamicResource TextBoxNormal}" Text="{Binding BillingAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                            behaviours:TextboxFilter.EnableFilter="True"
                                            behaviours:TextboxFilter.FilterMode="AlphaNumericWithSpaces" />
                                    </StackPanel>
                                </Grid>

                                <!-- city -->
                                <Grid Grid.Row="2" Margin="0,0,0,25">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Margin="5,0,0,5" Text="City" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                        <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                            behaviours:TextboxFilter.EnableFilter="True"
                                            behaviours:TextboxFilter.FilterMode="LettersAndSpacesOnly" />
                                    </StackPanel>
                                </Grid>

                                <!-- postcode -->
                                <Grid Grid.Row="3" Margin="0,0,0,25">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Margin="5,0,0,5" Text="Postcode" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                        <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding Postcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" 
                                            behaviours:TextboxFilter.EnableFilter="True"
                                            behaviours:TextboxFilter.FilterMode="AlphaNumericWithSpaces" />
                                    </StackPanel>
                                </Grid>

                                <!-- country -->
                                <Grid Grid.Row="4" Margin="0,0,0,0">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Margin="5,0,0,5" Text="Country" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FormFontColour}" FontSize="22"/>
                                        <TextBox Style="{DynamicResource TextBoxNormal}" Text="{Binding Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" AcceptsReturn="False" TextWrapping="Wrap" Padding="10" FontSize="22" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans"
                                            behaviours:TextboxFilter.EnableFilter="True"
                                            behaviours:TextboxFilter.FilterMode="LettersAndSpacesOnly" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- butons -->
            <Grid Grid.Row="2">
                <Grid Margin="40,0">
                    <Grid.ColumnDefinitions>
                        <!-- delete client -->
                        <ColumnDefinition Width="auto" />
                        
                        <!-- spacer -->
                        <ColumnDefinition Width="*" />
                        
                        <!-- save -->
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <!-- delete -->
                    <Grid Grid.Column="0">
                        <Border>
                            <Border.Triggers>
                                <!-- click animation -->
                                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <TextBlock Cursor="Hand" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action DeleteClient()]" conv:TextBlockSpacer.LetterSpacing="2.01" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Delete Client" FontFamily="pack://Traker:,,,/Resources/Fonts/#Inter" Foreground="{StaticResource DeleteText}" FontWeight="Regular" FontSize="16" />
                        </Border>
                    </Grid>

                    <!-- submit -->
                    <Grid Grid.Column="2" Opacity="{Binding OpacitySubmitBtn}">
                        <Border Cursor="Hand" x:Name="SubmitBorder" IsEnabled="{Binding EnableSubmitBtn}" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action ConfirmEditClient()]" CornerRadius="25" Height="45" Width="200">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Background" Value="{StaticResource FormSubmitBackground}" />

                                    <!-- DEFAULT STATE -->
                                    <Setter Property="BorderBrush">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                                <GradientStop Color="LightGray" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>

                                    <!-- HOVER STATE -->
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource FormSubmitHoverBackground}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Triggers>
                                <!-- click animation -->
                                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <TextBlock conv:TextBlockSpacer.LetterSpacing="2.01" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Save Changes" FontFamily="pack://Traker:,,,/Resources/Fonts/#Inter" FontWeight="SemiBold" Foreground="{StaticResource FormSubmitText}" FontSize="18" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>