<UserControl x:Class="Traker.Views.User.UserContextMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:local="clr-namespace:Traker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#101012" CornerRadius="15" BorderThickness="1.5" BorderBrush="#34343A" HorizontalAlignment="Left" Margin="20,0,0,0" Height="190" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.8" ShadowDepth="2" />
        </Border.Effect>

        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,10,10,0" Width="150">
            <!-- user -->
            <Border Cursor="Hand" x:Name="UserBorder" MouseLeave="UserBorder_MouseLeave" MouseLeftButtonUp="UserBorder_MouseLeftButtonUp" MouseLeftButtonDown="UserBorder_MouseLeftButtonDown" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action OpenOption('user')]" CornerRadius="20" Height="40" Margin="5,0,5,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="Background" Value="#151518"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D1D22"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Opacity="0.5" Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="40" Height="28" Width="28">
                        <svg:SvgViewbox                         
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True"
                            Source="/Resources/Media/Images/Icons/Lucide/user-round.svg" Width="15" Height="15"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" Text="User" FontFamily="pack://Traker:,,,/Resources/Fonts/#Inter" FontWeight="Regular" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#CFCFD6"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- business -->
            <Border Cursor="Hand" x:Name="BusinessBorder" MouseLeave="BusinessBorder_MouseLeave" MouseLeftButtonUp="BusinessBorder_MouseLeftButtonUp" MouseLeftButtonDown="BusinessBorder_MouseLeftButtonDown" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action OpenOption('business')]" CornerRadius="20" Height="40" Margin="5,0,5,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="Background" Value="#151518"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D1D22"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Opacity="0.5" Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="40" Height="28" Width="28">
                        <svg:SvgViewbox                         
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True"
                            Source="/Resources/Media/Images/Icons/Lucide/briefcase-business.svg" Width="15" Height="15"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" Text="Business" FontFamily="pack://Traker:,,,/Resources/Fonts/#Inter" FontWeight="Regular" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#CFCFD6"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- bank -->
            <Border Cursor="Hand" x:Name="BankBorder" MouseLeave="BankBorder_MouseLeave" MouseLeftButtonUp="BankBorder_MouseLeftButtonUp" MouseLeftButtonDown="BankBorder_MouseLeftButtonDown" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action OpenOption('bank')]" CornerRadius="20" Height="40" Margin="5,0,5,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="Background" Value="#151518"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D1D22"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Opacity="0.5" Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="40" Height="28" Width="28">
                        <svg:SvgViewbox                         
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True"
                            Source="/Resources/Media/Images/Icons/Lucide/landmark.svg" Width="15" Height="15"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" Text="Bank" FontFamily="pack://Traker:,,,/Resources/Fonts/#Inter" FontWeight="Regular" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#CFCFD6"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>