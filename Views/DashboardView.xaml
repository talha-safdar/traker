<UserControl x:Class="Traker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:cal="http://caliburnmicro.com"
             xmlns:conv="clr-namespace:Traker.Converters"
             xmlns:local="clr-namespace:Traker.Views" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <conv:BoolToVisibilityCollapsed x:Key="BoolToVisCollapsed"/>
        <conv:BoolToVisibilityCollapsedInverse x:Key="BoolToVisCollapsedInverse"/>
        <conv:DigitLengthConverter  x:Key="DigitLengthConverter"/>
    </UserControl.Resources>

    <!--
        
    use staticresource for static styles
    and dyanmicresource for theme changing
    
    -->

    <Grid Background="#080808" cal:Message.Attach="[Event PreviewMouseDown] = [Action OnMouseDownEvent($source)]">
        <Grid.ColumnDefinitions>
            <!--<ColumnDefinition Width="0.235*" /> --><!-- side panel -->
            <ColumnDefinition Width="auto" MinWidth="400" /> <!-- side panel -->
            <ColumnDefinition Width="*" MinWidth="800" /> <!-- main panel -->
        </Grid.ColumnDefinitions>
            
        <!-- side panel -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Grid.Column="0" Margin="20,20,10,20">     
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.1*" /> <!-- buttons -->
                    <RowDefinition Height="*" /> <!-- information status -->
                </Grid.RowDefinitions>

                <!-- buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <!-- panel container -->
                    <Border SnapsToDevicePixels="True" Background="#111113" CornerRadius="20" BorderThickness="1.5">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#5A5A64" Offset="0"/>
                                <GradientStop Color="#2A2A2F" Offset="0.45"/>
                                <GradientStop Color="#17171A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /> <!-- add client -->
                                <ColumnDefinition Width="0.15*" /> <!-- spacer -->
                                <ColumnDefinition Width="*" /> <!-- add job -->
                            </Grid.ColumnDefinitions>                       
                        
                            <!-- add client -->
                            <Grid Grid.Column="0" Margin="10,0,0,0">
                                <Border x:Name="SubmitAddClientBorder" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="2000" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action AddClient()]" VerticalAlignment="Center" CornerRadius="25" Height="50">
                                    <Border.ToolTip>
                                        <ToolTip Style="{StaticResource DarkToolTip}">
                                            <TextBlock Text="Add a new client with job" />
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- 1. Base Background (rgba 255,255,255, 0.05) -->
                                            <Setter Property="Background" Value="#1D1D22" />
                                            <Setter Property="BorderBrush" Value="#34343A" />
                                            <Setter Property="BorderThickness" Value="1.5" />

                                            <!-- 2. The 1px Gradient Border -->
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <!-- Top Highlight -->
                                                        <GradientStop Color="#40FFFFFF" Offset="0" />
                                                        <!-- Bottom Fade -->
                                                        <GradientStop Color="#05FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>

                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentColour}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.Triggers>
                                        <!-- click animation -->
                                        <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>


                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border SnapsToDevicePixels="True" BorderThickness="1" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action AddClient()]" VerticalAlignment="Center" CornerRadius="25" Height="50">
                                            <svg:SvgViewbox
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        SnapsToDevicePixels="True"
                                        Source="/Resources/Media/Images/Icons/Lucide/user-round-plus.svg" Width="25" Height="25"/>
                                    </Border>
                                        <TextBlock VerticalAlignment="Center" Margin="15,0,0,0" Text="Add Client" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#888888"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=SubmitAddClientBorder}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        
                            <!-- spacer -->
                            <Grid Grid.Column="1">
                                <!-- spacer -->                            
                                <Border Margin="10,10" Width="1" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <!-- StartPoint/EndPoint set to Y-axis (0,0 to 0,1) for vertical fade -->
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" Opacity="1">
                                            <!-- Left: Transparent -->
                                            <GradientStop Color="#00555555" Offset="0" />
                                            <!-- Middle: Your #555555 color -->
                                            <GradientStop Color="#1F1F25" Offset="0.5" />
                                            <!-- Right: Transparent -->
                                            <GradientStop Color="#00555555" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        
                            <!-- add job -->
                            <Grid Grid.Column="2" Margin="0,0,10,0" Opacity="{Binding OpacityBtns}">
                                <Border x:Name="SubmitAddJobBorder" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="2000" IsEnabled="{Binding EnableBtns}" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action AddJob()]" VerticalAlignment="Center" CornerRadius="25" Height="50">
                                    <Border.ToolTip>
                                        <ToolTip Style="{StaticResource DarkToolTip}">
                                            <TextBlock Text="Add job to an existing client" />
                                        </ToolTip>
                                    </Border.ToolTip>

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- 1. Base Background (rgba 255,255,255, 0.05) -->
                                            <Setter Property="Background" Value="#1D1D22" />
                                            <Setter Property="BorderBrush" Value="#34343A" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Setter Property="BorderThickness" Value="1.5" />

                                            <!-- 2. The 1px Gradient Border -->
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <!-- Top Highlight -->
                                                        <GradientStop Color="#40FFFFFF" Offset="0" />
                                                        <!-- Bottom Fade -->
                                                        <GradientStop Color="#05FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>

                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentColour}" />
                                                </Trigger>                                                
                                            </Style.Triggers>                             
                                        </Style>
                                    </Border.Style>

                                    <Border.Triggers>
                                        <!-- click animation -->
                                        <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>

                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border SnapsToDevicePixels="True" BorderThickness="1" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action AddClient()]" VerticalAlignment="Center" CornerRadius="25" Height="50">
                                                <svg:SvgViewbox
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            SnapsToDevicePixels="True"
                                            Source="/Resources/Media/Images/Icons/Lucide/briefcase-business.svg" Width="25" Height="25"/>
                                        </Border>
                                            <TextBlock VerticalAlignment="Center" Margin="15,0,0,0" Text="Add Job" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=SubmitAddJobBorder}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>                                                
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>                         
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- infromation status -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <!-- panel container -->
                    <Border Background="#101012" CornerRadius="20" BorderThickness="1.5">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#46464F" Offset="0"/>
                                <GradientStop Color="#29292F" Offset="0.45"/>
                                <GradientStop Color="#151518" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" /> <!-- jobs information -->
                                <RowDefinition Height="0.05*" /> <!-- spacer -->
                                <RowDefinition Height="auto" /> <!-- money information -->
                                <RowDefinition Height="0.15*" /> <!-- spacer -->
                                <RowDefinition Height="auto" /> <!-- profile / account -->
                            </Grid.RowDefinitions>

                            <!-- jobs information -->
                            <Grid Grid.Row="0" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- new -->
                                <Grid Grid.Column="0" Grid.Row="0" Margin="10,0,10,20">
                                    <Border CornerRadius="10" BorderThickness="1" SnapsToDevicePixels="True">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                                <!-- This whole gradient is now at 50% of its original opacity -->
                                                <GradientStop Color="LightGray" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Foreground="{StaticResource JobStatusNew}" Margin="5,0,0,0" Text="New" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" FontSize="22" />
                                            <TextBlock Margin="5,0,0,0" Text="{Binding NewJobsCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Bold" Foreground="{StaticResource FontSecondaryBrush}" Opacity="0.7">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="42"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="5">
                                                                <Setter Property="FontSize" Value="34"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="6">
                                                                <Setter Property="FontSize" Value="28"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="7">
                                                                <Setter Property="FontSize" Value="24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="8">
                                                                <Setter Property="FontSize" Value="21"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="9">
                                                                <Setter Property="FontSize" Value="19"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="10">
                                                                <Setter Property="FontSize" Value="17"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="11">
                                                                <Setter Property="FontSize" Value="15"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="12">
                                                                <Setter Property="FontSize" Value="14"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="13">
                                                                <Setter Property="FontSize" Value="13"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="14">
                                                                <Setter Property="FontSize" Value="12"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="15">
                                                                <Setter Property="FontSize" Value="11"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="16">
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>    
                                    </Border>
                                </Grid>
                            
                                <!-- active -->
                                <Grid Grid.Column="1" Grid.Row="0" Margin="10,0,10,20">
                                    <Border CornerRadius="10" BorderThickness="1" SnapsToDevicePixels="True">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                                <!-- This whole gradient is now at 50% of its original opacity -->
                                                <GradientStop Color="LightGray" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Foreground="{StaticResource JobStatusActive}" Margin="5,0,0,0" Text="Active" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" FontSize="22" />
                                            <TextBlock Margin="5,0,0,0" Text="{Binding ActiveJobsCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Bold" Foreground="{StaticResource FontSecondaryBrush}" Opacity="0.7">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="42"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="5">
                                                                <Setter Property="FontSize" Value="34"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="6">
                                                                <Setter Property="FontSize" Value="28"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="7">
                                                                <Setter Property="FontSize" Value="24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="8">
                                                                <Setter Property="FontSize" Value="21"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="9">
                                                                <Setter Property="FontSize" Value="19"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="10">
                                                                <Setter Property="FontSize" Value="17"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="11">
                                                                <Setter Property="FontSize" Value="15"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="12">
                                                                <Setter Property="FontSize" Value="14"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="13">
                                                                <Setter Property="FontSize" Value="13"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="14">
                                                                <Setter Property="FontSize" Value="12"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="15">
                                                                <Setter Property="FontSize" Value="11"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="16">
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Done -->
                                <Grid Grid.Column="0" Grid.Row="1" Margin="10,0,10,0">
                                    <Border CornerRadius="10" BorderThickness="1" SnapsToDevicePixels="True">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                                <!-- This whole gradient is now at 50% of its original opacity -->
                                                <GradientStop Color="LightGray" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Foreground="{StaticResource JobStatusDone}" Margin="5,0,0,0" Text="Done" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" FontSize="22" />
                                            <TextBlock Margin="5,0,0,0" Text="{Binding DoneJobsCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Bold" Foreground="{StaticResource FontSecondaryBrush}" Opacity="0.7">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="42"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="5">
                                                                <Setter Property="FontSize" Value="34"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="6">
                                                                <Setter Property="FontSize" Value="28"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="7">
                                                                <Setter Property="FontSize" Value="24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="8">
                                                                <Setter Property="FontSize" Value="21"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="9">
                                                                <Setter Property="FontSize" Value="19"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="10">
                                                                <Setter Property="FontSize" Value="17"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="11">
                                                                <Setter Property="FontSize" Value="15"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="12">
                                                                <Setter Property="FontSize" Value="14"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="13">
                                                                <Setter Property="FontSize" Value="13"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="14">
                                                                <Setter Property="FontSize" Value="12"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="15">
                                                                <Setter Property="FontSize" Value="11"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="16">
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>                            

                                <!-- invoiced -->
                                <Grid Grid.Column="1" Grid.Row="1" Margin="10,0,10,0">
                                    <Border CornerRadius="10" BorderThickness="1" SnapsToDevicePixels="True">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                                <!-- This whole gradient is now at 50% of its original opacity -->
                                                <GradientStop Color="LightGray" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Foreground="{StaticResource JobStatusInvoiced}" Margin="5,0,0,0" Text="Invoiced" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" FontSize="22" />
                                            <TextBlock Margin="5,0,0,0" Text="{Binding InvoicedJobsCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Bold" Foreground="{StaticResource FontSecondaryBrush}" Opacity="0.7">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="42"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="5">
                                                                <Setter Property="FontSize" Value="34"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="6">
                                                                <Setter Property="FontSize" Value="28"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="7">
                                                                <Setter Property="FontSize" Value="24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="8">
                                                                <Setter Property="FontSize" Value="21"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="9">
                                                                <Setter Property="FontSize" Value="19"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="10">
                                                                <Setter Property="FontSize" Value="17"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="11">
                                                                <Setter Property="FontSize" Value="15"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="12">
                                                                <Setter Property="FontSize" Value="14"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="13">
                                                                <Setter Property="FontSize" Value="13"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="14">
                                                                <Setter Property="FontSize" Value="12"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="15">
                                                                <Setter Property="FontSize" Value="11"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewJobsCount, Converter={StaticResource DigitLengthConverter}}" Value="16">
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        
                            <!-- spacer -->
                            <Grid Grid.Row="1" />

                            <!-- money information -->
                            <Grid Grid.Row="2" Width="325">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" /> <!-- gross -->
                                    <RowDefinition Height="*" /> <!-- received -->
                                    <RowDefinition Height="*" /> <!-- overdue -->
                                    <RowDefinition Height="*" /> <!-- outstanding -->
                                </Grid.RowDefinitions>
                            
                                <!-- gross payment -->
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Vertical" Margin="10,10,10,30">
                                        <TextBlock Margin="5,0,0,5" Text="Gross" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FontSecondaryBrush}" FontSize="22" />
                                        <Border CornerRadius="10" BorderThickness="1.5" SnapsToDevicePixels="True">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="LightGray" Opacity="0.25" />
                                            </Border.BorderBrush>
                                            <TextBox Style="{StaticResource TextBoxReadOnly}" Cursor="Arrow" Foreground="{StaticResource FontSecondaryBrush}" IsReadOnly="True" Text="{Binding GrossAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="NoWrap" Padding="15,10,10,10" FontSize="32" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" BorderThickness="0" />                                        
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                                        
                                <!-- outstanding payment -->
                                <Grid Grid.Row="1">
                                    <StackPanel Orientation="Vertical" Margin="10,10,10,30">
                                        <TextBlock Margin="5,0,0,5" Text="Outstanding" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FontSecondaryBrush}" FontSize="22" />
                                        <Border CornerRadius="10" BorderThickness="1.5" SnapsToDevicePixels="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="LightGray" Opacity="0.25"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutstandingStatusBorder}" Value="Overdue">
                                                            <Setter Property="BorderBrush" Value="{StaticResource JobStatusOverdue}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBox Style="{StaticResource TextBoxReadOnly}" Cursor="Arrow" Foreground="{StaticResource FontSecondaryBrush}" IsReadOnly="True" Text="{Binding OutstandingAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="NoWrap" Padding="15,10,10,10" FontSize="32" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" BorderThickness="0" />
                                        </Border>
                                    </StackPanel>
                                </Grid>     
                            
                                <!-- received payment -->
                                <Grid Grid.Row="2">
                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Margin="5,0,0,5" Text="Received" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FontSecondaryBrush}" FontSize="22" />
                                        <Border CornerRadius="10" BorderThickness="1.5" SnapsToDevicePixels="True">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="LightGray" Opacity="0.25" />
                                            </Border.BorderBrush>
                                            <TextBox Style="{StaticResource TextBoxReadOnly}" Cursor="Arrow" Foreground="{StaticResource FontSecondaryBrush}" IsReadOnly="True" Text="{Binding ReceivedAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="NoWrap" Padding="15,10,10,10" FontSize="32" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" BorderThickness="0" />
                                        </Border>
                                    </StackPanel>
                                </Grid>              
                            </Grid>

                            <!-- spacer -->
                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <Border Margin="30,0" Height="1" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" Opacity="1">
                                            <!-- Left: Transparent -->
                                            <GradientStop Color="#00555555" Offset="0" />
                                            <!-- Middle: Your #555555 color -->
                                            <GradientStop Color="#1F1F25" Offset="0.5" />
                                            <!-- Right: Transparent -->
                                            <GradientStop Color="#00555555" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <!-- profile / account -->
                            <Grid Grid.Row="4">
                                <Border x:Name="SubmitUserBorder" ToolTipService.ShowDuration="1000" Cursor="Hand" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action OpenUserContenxtMenu($source)]" CornerRadius="30" Height="65" Padding="5,0" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#151518"/>
                                            <Setter Property="BorderBrush" Value="#2A2A2F" />

                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1D1D22"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.Triggers>
                                        <!-- click animation -->
                                        <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>

                                    <Border.ToolTip>
                                        <ToolTip Style="{StaticResource DarkToolTip}">
                                            <TextBlock Text="Edit Your Information" />
                                        </ToolTip>
                                    </Border.ToolTip>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /> <!-- icon / name -->
                                            <ColumnDefinition Width="auto" /> <!-- click icon -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- icon / name -->
                                        <Grid Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                                                    <svg:SvgViewbox                         
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    SnapsToDevicePixels="True"
                                                    Source="/Resources/Media/Images/Icons/Lucide/user-round-cog.svg" Width="25" Height="25"/>
                                                <TextBlock VerticalAlignment="Center" Margin="15,4,0,0" Text="{Binding UserName}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="22" />
                                            </StackPanel>    
                                        </Grid>

                                        <!-- click icon -->
                                        <Grid Grid.Column="1">
                                            <svg:SvgViewbox   
                                                VerticalAlignment="Center"
                                                Margin="0,0,20,0"
                                                Opacity="0.3"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                SnapsToDevicePixels="True"
                                                Source="/Resources/Media/Images/Icons/Lucide/chevron-up.svg" Width="20" Height="20"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
        
        <!-- main panel -->
        <Grid Grid.Column="1" Margin="10,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" /> <!-- search / filter / sort -->
                <RowDefinition Height="*" /> <!-- job cards -->
                <RowDefinition Height="0" /> <!-- info bar for V2 -->
            </Grid.RowDefinitions>

            <!-- search / filter / sort -->
            <Grid Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />                        <!-- total jobs (to become search bar) -->
                        <ColumnDefinition Width="*" />                       <!-- line spacer -->
                        <ColumnDefinition Width="auto" />                        <!-- filter/sort -->
                    </Grid.ColumnDefinitions>

                    <!-- total jobs (to become search bar) -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Margin="5,0,0,0" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FontSecondaryBrush}" FontSize="22">
                            <Run Text="Total Jobs: " />
                            <Run Text="{Binding TotalJobsCount}" />
                        </TextBlock>
                    </Grid>

                    <!-- line spacer -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Border Margin="30,0" Height="1" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" Opacity="1">
                                    <!-- Left: Transparent -->
                                    <GradientStop Color="#00555555" Offset="0" />
                                    <!-- Middle: Your #555555 color -->
                                    <GradientStop Color="#1F1F25" Offset="0.5" />
                                    <!-- Right: Transparent -->
                                    <GradientStop Color="#00555555" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- filter/sort -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0" Opacity="{Binding OpacityBtns}" >
                            
                            <!-- filter -->
                            <Border ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="1000" x:Name="SubmitFilterBorder" Cursor="Hand" IsEnabled="{Binding EnableBtns}" SnapsToDevicePixels="True" Margin="0,0,10,0" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action OpenFilterContextMenu($source)]" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="40" Height="35" Width="35">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Background" Value="#151518"/>
                                        <Setter Property="BorderBrush" Value="#2A2A2F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.IsFilterInUse}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentColour}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1D1D22" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentColour}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Border.Triggers>
                                    <!-- click animation -->
                                    <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>

                                <Border.ToolTip>
                                    <ToolTip Style="{StaticResource DarkToolTip}">
                                        <TextBlock Text="Filter Jobs" />
                                    </ToolTip>
                                </Border.ToolTip>
                                <svg:SvgViewbox                         
                                    Margin="0,2,0,0"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="/Resources/Media/Images/Icons/Lucide/list-filter.svg" Width="15" Height="15"/>
                            </Border>
                            
                            <!-- sort -->
                            <Border ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="1000" x:Name="SubmitSortBorder" Cursor="Hand" IsEnabled="{Binding EnableBtns}" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action OpenSortContextMenu($source)]" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="40" Height="35" Width="35">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Background" Value="#151518"/>
                                        <Setter Property="BorderBrush" Value="#2A2A2F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.IsSortInUse}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentColour}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1D1D22" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentColour}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Border.Triggers>
                                    <!-- click animation -->
                                    <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>

                                <Border.ToolTip>
                                    <ToolTip Style="{StaticResource DarkToolTip}">
                                        <TextBlock Text="Sort Jobs" />
                                    </ToolTip>
                                </Border.ToolTip>
                                <svg:SvgViewbox         
                                    Margin="0,1,0,0"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="/Resources/Media/Images/Icons/Lucide/arrow-up-down.svg" Width="15" Height="15"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- job cards -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Border Background="#0C0C0E" BorderBrush="#24242A" BorderThickness="1.5" CornerRadius="20" SnapsToDevicePixels="True">
                    <Grid>

                        <!--<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,20,10,10" Padding="0,0,10,0" CanContentScroll="True">-->
                            <ListBox ItemsSource="{Binding DashboardData}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"

                                        ScrollViewer.CanContentScroll="True"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                        VirtualizingPanel.ScrollUnit="Pixel"
                                        VirtualizingPanel.CacheLength="2"
                                        VirtualizingPanel.CacheLengthUnit="Page">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,20,0,10"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border 
                                        SnapsToDevicePixels="True"
                                        BorderThickness="1.5"
                                        ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="2000" 
                                        Height="135"
                                        CornerRadius="20" 
                                        Margin="20,0,20,0" 
                                        Padding="10"
                                            cal:Message.Attach="
                                                            [Event MouseLeftButtonUp] = [Action SelectJob($dataContext)];
                                                            [Event MouseEnter] = [Action SelectJob($dataContext)];
                                                            [Event MouseRightButtonUp] = [Action OpenContextMenu($dataContext)];"
                                            Cursor="Hand"
                                        MouseLeftButtonDown="EditJob">

                                        <Border.ToolTip>
                                            <ToolTip Style="{StaticResource DarkToolTip}">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Double-click to edit job | right click for more"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding JobStatus}" Value="Invoiced">
                                                                    <Setter Property="Text" Value="Double-click to view invoice | right click for more"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding JobStatus}" Value="Overdue">
                                                                    <Setter Property="Text" Value="Double-click to view invoice | right click for more"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding JobStatus}" Value="Paid">
                                                                    <Setter Property="Text" Value="Double-click to view invoice | right click for more"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- 1. Default BorderBrush -->
                                                <Setter Property="Background" Value="#151518"/>
                                                <Setter Property="BorderBrush">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="#4A4A55" Offset="0"/>
                                                            <GradientStop Color="#2D2D34" Offset="0.45"/>
                                                            <GradientStop Color="#1F1F25" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <!-- 2. Default Shadow (Moved from local to Style) -->
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="Black" 
                                                          BlurRadius="15" 
                                                         Direction="270"
                                                          ShadowDepth="5" 
                                                          Opacity="0.4" 
                                                          RenderingBias="Quality"/>
                                                    </Setter.Value>
                                                </Setter>

                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1D1D22"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                                                        <!-- on pressed:
                                                        Background: #202027
                                                        Border:     #A7B4CC-->


                                                        <!-- 3. Increased Blur Shadow on Hover -->
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="Black" 
                                                              BlurRadius="30" 
                                                              ShadowDepth="0" 
                                                              Opacity="0.8" 
                                                              RenderingBias="Quality"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.3*" />                                                <!-- type -->
                                                <ColumnDefinition Width="*" />                                                <!-- full name / job title -->
                                                <ColumnDefinition Width="0.2*" />                                                <!-- spacer -->
                                                <ColumnDefinition Width="0.5*" />                                                <!-- job status / due date -->
                                                <ColumnDefinition Width="0.2*" />                                                <!-- spacer -->
                                                <ColumnDefinition Width="*" />                                                <!-- job price -->
                                                <ColumnDefinition Width="auto" />                                                <!-- buttons -->
                                            </Grid.ColumnDefinitions>

                                            <!-- type -->
                                            <Grid Grid.Column="0">
                                                <Border Width="6" HorizontalAlignment="Left" CornerRadius="3" Margin="0,10" >
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1E1E1E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding JobStatus}" Value="New">
                                                                    <Setter Property="Background" Value="{StaticResource JobStatusNew}" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding JobStatus}" Value="Active">
                                                                    <Setter Property="Background" Value="{StaticResource JobStatusActive}" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding JobStatus}" Value="Done">
                                                                    <Setter Property="Background" Value="{StaticResource JobStatusDone}" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding JobStatus}" Value="Invoiced">
                                                                    <Setter Property="Background" Value="{StaticResource JobStatusInvoiced}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding InvoiceStatus}" Value="Overdue">
                                                                    <Setter Property="Background" Value="{StaticResource JobStatusOverdue}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding InvoiceStatus}" Value="Paid">
                                                                    <Setter Property="Background" Value="{StaticResource JobStatusPaid}" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="40" Height="80" Width="80">
                                                    <svg:SvgViewbox                         
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        SnapsToDevicePixels="True"
                                                        Source="{Binding TypeIcon}" Width="35" Height="35"/>
                                                </Border>
                                            </Grid>

                                            <!-- full name / job title -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />                                                    <!-- full name -->
                                                    <RowDefinition Height="*" />                                                    <!-- spacer -->
                                                    <RowDefinition Height="*" />                                                    <!-- job title -->
                                                </Grid.RowDefinitions>

                                                <!-- full name -->
                                                <Grid Grid.Row="0">
                                                    <TextBlock Margin="5,0,0,0" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Black" Foreground="{StaticResource FontPrimaryBrush}" FontSize="32">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <!-- Default Value client name -->
                                                                <Setter Property="Text" Value="{Binding ClientName}" />
                                                                <Style.Triggers>
                                                                    <!-- if client type is company use company name -->
                                                                    <DataTrigger Binding="{Binding ClientType}" Value="Company">
                                                                        <Setter Property="Text" Value="{Binding CompanyName}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- spacer -->
                                                <Grid Grid.Row="1" Margin="0,10" />

                                                <!-- job title -->
                                                <Grid Grid.Row="2">
                                                    <TextBlock Margin="5,0,0,0" Opacity="0.8" Text="{Binding JobTitle}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="#888888" FontSize="24" />
                                                </Grid>
                                            </Grid>

                                            <!-- spacer-->
                                            <Grid Grid.Column="2">
                                            </Grid>

                                            <!-- job status / due date -->
                                            <Grid Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />                                                    <!-- job status -->
                                                    <RowDefinition Height="0.5*" />                                                    <!-- spacer -->
                                                    <RowDefinition Height="*" />                                                    <!-- due date -->
                                                </Grid.RowDefinitions>

                                                <!-- job status -->
                                                <Grid Grid.Row="0">
                                                    <TextBlock Margin="0" Foreground="#E0E0E0" Typography.Capitals="AllSmallCaps" conv:TextBlockSpacer.LetterSpacing="0.50" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="SemiBold" FontSize="32">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding JobStatus}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding InvoiceStatus}" Value="Invoiced">
                                                                        <Setter Property="Text" Value="{Binding InvoiceStatus}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding InvoiceStatus}" Value="Overdue">
                                                                        <Setter Property="Text" Value="{Binding InvoiceStatus}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding InvoiceStatus}" Value="Paid">
                                                                        <Setter Property="Text" Value="{Binding InvoiceStatus}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- spacer -->
                                                <Grid Grid.Row="1" Margin="0,10" />

                                                <!-- due date -->
                                                <Grid Grid.Row="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock HorizontalAlignment="Left" Margin="0" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Bold" Foreground="#555555" FontSize="24">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Due" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding InvoiceStatus}" Value="Invoiced">
                                                                            <Setter Property="Text" Value="Due" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding InvoiceStatus}" Value="Overdue">
                                                                            <Setter Property="Text" Value="Due" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding InvoiceStatus}" Value="Paid">
                                                                            <Setter Property="Text" Value="On" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Margin="10,0,0,0" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" Foreground="{StaticResource FontPrimaryBrush}" FontSize="24">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                     <!-- job status due date -->
                                                                    <Setter Property="Text" Value="{Binding DueDate}" />
                                                                    
                                                                    <!-- invoiced status due date -->
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding InvoiceStatus}" Value="Invoiced">
                                                                            <Setter Property="Text" Value="{Binding InvoiceDueDate}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding InvoiceStatus}" Value="Overdue">
                                                                            <Setter Property="Text" Value="{Binding InvoiceDueDate}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding InvoiceStatus}" Value="Paid">
                                                                            <Setter Property="Text" Value="{Binding PaidDate}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <!-- spacer -->
                                            <Grid Grid.Column="4" />

                                            <!-- job price -->
                                            <Grid Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Margin="0" Text="{Binding Price, StringFormat={}{0:C}}" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" FontWeight="Bold" Foreground="#E0E0E0" FontSize="32" />
                                            </Grid>
                                            
                                            <!-- buttons -->
                                                <Grid Grid.Column="6">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border Opacity="0.5" Cursor="Hand" SnapsToDevicePixels="True" Margin="0,0,0,40" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action EditJob($source)]" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="40" Height="35" Width="35">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FF2E2E2E"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <svg:SvgViewbox                         
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        SnapsToDevicePixels="True"
                                                        Source="/Resources/Media/Images/Icons/Lucide/pen.svg" Width="15" Height="15"/>
                                                    </Border>
                                                        <Border Visibility="Hidden" Opacity="0.5" Cursor="Hand" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action DeleteJob()]" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="40" Height="35" Width="35">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#33FF0000"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>


                                                            <svg:SvgViewbox                         
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    SnapsToDevicePixels="True"
                                                    Source="/Resources/Media/Images/Icons/Lucide/trash-2.svg" Width="15" Height="15"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    <!--</ScrollViewer>-->

                        <!-- add client -->
                        <Border Cursor="Hand" x:Name="SubmitAddClientEmptyBorder" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="5000" Visibility="{Binding EnableBtns, Converter={StaticResource BoolToVisCollapsedInverse}}" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action AddClient()]" SnapsToDevicePixels="True" BorderThickness="1.5" Background="#1E1E1E" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="30" Height="60" Width="240">
                            <Border.ToolTip>
                                <ToolTip Style="{StaticResource DarkToolTip}"
                                    Content="Click to add client"/>
                            </Border.ToolTip>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Background" Value="#1D1D22" />

                                    <!-- DEFAULT STATE -->
                                    <Setter Property="BorderBrush">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
                                                <GradientStop Color="LightGray" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>

                                    <!-- HOVER STATE -->
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#25252B"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentColour}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Triggers>
                                <!-- click animation -->
                                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource ClickOpacity}" Duration="0:0:0.01" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <svg:SvgViewbox
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,0"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="/Resources/Media/Images/Icons/Lucide/user-round-plus.svg" Width="25" Height="25"/>
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0" Text="Add Client" FontFamily="pack://Traker:,,,/Resources/Fonts/#Montserrat" FontWeight="Regular" FontSize="18">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=SubmitAddClientEmptyBorder}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource FontSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- pagination buttons -->
            <Grid Grid.Row="1" Grid.RowSpan="2">
                <Border BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="25,0,0,15" Padding="8,2,8,1" CornerRadius="22">
                    <Border.Style>
                        <Style TargetType="Border">     
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Background" Value="#151518" />
                            <Setter Property="BorderBrush" Value="#34343A" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1.0" />
                                    <Setter Property="Background" Value="#1D1D22" />
                                    <Setter Property="BorderBrush" Value="#4A4A55" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding PaginationButtons[0]}" Value="False" />
                                        <Condition Binding="{Binding PaginationButtons[1]}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect
                        Color="Black"
                        BlurRadius="24"
                        ShadowDepth="0"
                        Opacity="0.5"
                        Direction="0" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border IsEnabled="{Binding PaginationButtons[0]}" Cursor="Hand" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action PreviousPage()]">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                <Condition Binding="{Binding PaginationButtons[0]}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Opacity" Value="0.7" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding PaginationButtons[0]}" Value="False">
                                            <Setter Property="Opacity" Value="0.2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <svg:SvgViewbox                         
                                RenderOptions.BitmapScalingMode="HighQuality"
                                SnapsToDevicePixels="True"
                                Source="/Resources/Media/Images/Icons/Lucide/circle-chevron-left.svg" Width="30" Height="30"/>
                        </Border>
                        <TextBlock Cursor="Arrow" Foreground="{StaticResource FontSecondaryBrush}" Text="{Binding PageInfo}" Padding="10" FontSize="18" FontFamily="pack://Traker:,,,/Resources/Fonts/#Public Sans" />

                        <Border IsEnabled="{Binding PaginationButtons[1]}" Cursor="Hand" SnapsToDevicePixels="True" cal:Message.Attach="[Event MouseLeftButtonUp] = [Action NextPage()]">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                <Condition Binding="{Binding PaginationButtons[1]}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Opacity" Value="0.7" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding PaginationButtons[1]}" Value="False">
                                            <Setter Property="Opacity" Value="0.2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <svg:SvgViewbox                         
                                RenderOptions.BitmapScalingMode="HighQuality"
                                SnapsToDevicePixels="True"
                                Source="/Resources/Media/Images/Icons/Lucide/circle-chevron-right.svg" Width="30" Height="30"/>
                        </Border>
                    
                    </StackPanel>
                </Border>


            </Grid>
            
            <!-- info bar for V2 -->
            <Grid Visibility="Collapsed" Grid.Row="2">
                <Border Background="#202020" CornerRadius="20" BorderThickness="1.5" SnapsToDevicePixels="True" Margin="0,15,0,0">
                    
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
